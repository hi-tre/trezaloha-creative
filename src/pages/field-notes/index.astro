---
// src/pages/field-notes/index.astro, Field Notes listing:
// giant title + filter tabs + a MASONRY card grid (varied heights).
// Real posts + "Coming Soon" placeholders (populate later).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cover from '../../components/Cover.astro';
import Img from '../../components/Img.astro';
import { articles } from '../../data/articles.mjs';
import { url } from '../../utils/url.mjs';

// Filter tabs: All + the tags actually present, in a stable order.
const TAG_ORDER = ['Culture', 'Art', 'Design', 'Practice'];
const present = TAG_ORDER.filter(t => articles.some(a => a.tag === t));
const tags = ['All', ...present, ...Array.from(new Set(articles.map(a => a.tag))).filter(t => !TAG_ORDER.includes(t))];
---

<BaseLayout title="Field Notes" description="Field notes from Trezaloha Creative, on culture, design, and indigenous creativity.">

  <!-- ── Header: giant title + filter tabs ── -->
  <section class="news-head">
    <div class="container">
      <h1 class="news-title-big" data-reveal="mask"><span>Field Notes</span></h1>
      <p class="news-subtitle" data-reveal style="--i:1">On culture, design &amp; craft.</p>
      <div class="news-tabs" data-reveal style="--i:2">
        {tags.map((t, i) => (
          <button class={`news-tab ${i === 0 ? 'active' : ''}`} data-filter={t}>
            <span class="news-tab-dot" aria-hidden="true"></span>{t}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Masonry grid ── -->
  <section class="section-tight news-section">
    <div class="container">
      <div class="news-grid bento" id="news-grid">
        {articles.map((a, i) => {
          return (
            <a href={url(`/field-notes/${a.slug}`)} class="news-card bento-card" data-card data-tag={a.tag} data-reveal>
              <div class="news-thumb frame" data-reveal="clip">
                {a.thumb
                  ? <Img src={`articles/${a.thumb}`} alt={a.title} loading={i < 2 ? 'eager' : 'lazy'} />
                  : <Cover tag={a.tag} variant="card" />}
                {a.featured && <span class="news-featured">Featured</span>}
                <div class="news-block">
                  <h2 class="news-title">{a.title}</h2>
                  <div class="news-meta">
                    <span class="news-date">{a.date}</span>
                    <span class="news-readmore">Read More →</span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <p class="news-empty" id="news-empty" hidden>No notes in this category yet.</p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Header ── (main already clears the fixed nav; just add modest top space) */
  .news-head { padding: var(--space-lg) 0 var(--space-md); }
  .news-title-big {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: 0.84;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .news-subtitle { margin-top: var(--space-sm); font-size: var(--fs-md); color: var(--color-text-muted); }
  .news-tabs {
    display: flex; flex-wrap: wrap; gap: var(--space-md);
    margin-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-sm);
  }
  .news-tab {
    background: none; border: none; cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--fs-xs); font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-text-muted);
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.25rem 0; transition: color var(--transition);
  }
  .news-tab-dot {
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: var(--color-accent); opacity: 0; transition: opacity var(--transition);
  }
  .news-tab:hover { color: var(--color-ink); }
  .news-tab.active { color: var(--color-ink); }
  .news-tab.active .news-tab-dot { opacity: 1; }

  /* ── Bento grid (first card full row, then a 2-up row, then varied spans) ── */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: clamp(128px, 13vw, 205px);
    grid-auto-flow: row dense;
    gap: var(--space-sm);
  }
  .news-card {
    position: relative;
    overflow: hidden;
    color: inherit; display: block;
    background: var(--color-surface);
  }
  .news-card.is-hidden { display: none; }

  .news-thumb { position: absolute; inset: 0; width: 100%; height: 100%; }
  .news-thumb img { width: 100%; height: 100%; object-fit: cover; }

  .news-featured {
    position: absolute; top: 1rem; left: 1rem; z-index: 3;
    font-size: var(--fs-2xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--color-accent); color: #0a0a0a; padding: 0.3rem 0.7rem;
  }

  /* White info block, bottom-left, overlapping the image */
  .news-block {
    position: absolute; left: 0; bottom: 0; z-index: 2;
    max-width: 88%;
    background: #fff;
    padding: 1.1rem 1.25rem 1.15rem;
  }
  .news-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.6rem);
    line-height: 1.02; text-transform: uppercase; color: var(--color-ink);
  }
  .news-meta {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-sm); margin-top: 0.7rem;
  }
  .news-date {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: var(--fs-2xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .news-date::before {
    content: ''; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--color-accent); flex-shrink: 0;
  }
  .news-readmore {
    font-size: var(--fs-2xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-ink); white-space: nowrap; transition: color var(--transition);
  }
  .news-card:hover .news-readmore { color: var(--color-accent-2); }

  /* ── Image-less cards: clean typographic tiles ── */
  .news-card--noimg { background: var(--color-surface); border: 1px solid var(--color-border); }
  .news-card--noimg .news-thumb { display: flex; align-items: flex-end; }
  .news-card--noimg .news-block {
    position: static; background: transparent; max-width: 100%;
    padding: clamp(1.1rem, 2vw, 1.6rem);
  }
  .news-card--noimg .news-title { font-size: clamp(1.25rem, 1.9vw, 1.9rem); }
  .news-card-tag {
    display: block; margin-bottom: 0.6rem;
    font-size: var(--fs-2xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-accent-2);
  }
  .news-card--noimg:hover .news-readmore { color: var(--color-accent-2); }

  .news-empty { color: var(--color-text-muted); font-size: var(--fs-md); padding: var(--space-lg) 0; }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .news-grid { grid-template-columns: 1fr; grid-auto-rows: auto; gap: var(--space-md); }
    .news-card { aspect-ratio: 4 / 3; }
    .news-readmore { opacity: 1; transform: none; }
  }
</style>

<script>
  import { initBento, layoutBento } from '../../scripts/bento.js';

  // Filter tabs (by tag) over the bento grid
  const grid = document.getElementById('news-grid');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.news-tab');
  const cards = document.querySelectorAll<HTMLElement>('.news-card');
  const empty = document.getElementById('news-empty');

  initBento(grid);

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const f = tab.getAttribute('data-filter');
      let shown = 0;
      cards.forEach(c => {
        const show = f === 'All' || c.getAttribute('data-tag') === f;
        c.classList.toggle('is-hidden', !show);
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      layoutBento(grid);
    });
  });
</script>
