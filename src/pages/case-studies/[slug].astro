---
// src/pages/case-studies/[slug].astro
// One page per case study — EDITORIAL redesign:
// giant Anton title hero, big framed hero image, numbered sections with
// gold-subheaded text blocks, inline framed images, a full-black overview
// section for rhythm, YouTube embed(s), and related projects.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import { caseStudies } from '../../data/case-studies.mjs';

export function getStaticPaths() {
  return caseStudies.map(cs => ({
    params: { slug: cs.slug },
    props: { study: cs },
  }));
}

const { study } = Astro.props;

const related = caseStudies.filter(cs => study.relatedSlugs.includes(cs.slug)).slice(0, 3);

// Normalize video data: support a single `videoId` or a list via `videoIds`.
const videos = study.videoIds ?? (study.videoId ? [study.videoId] : []);

const num = (i) => String(i + 1).padStart(2, '0');

const isArt = study.type === 'art';
---

<BaseLayout title={study.title} description={study.overview}>

  <!-- ── Hero: giant Anton title ── -->
  <section class="cs-hero">
    <div class="container">
      <p class="eyebrow cs-category" data-reveal>{isArt ? `Art · ${study.discipline}` : study.category}</p>
      <h1 class="cs-title" data-reveal="mask"><span>{study.title}</span></h1>
      <div class="cs-hero-meta">
        <p class="cs-subtitle" data-reveal style="--i:1">{study.subtitle}</p>
        <div class="cs-hero-aside" data-reveal style="--i:2">
          {isArt ? (
            <p class="cs-award">{study.medium}{study.year ? ` · ${study.year}` : ''}</p>
          ) : (
            <p class="cs-award">{study.award}</p>
          )}
          {study.liveLink && (
            <a
              href={study.liveLink}
              target={study.liveLink.startsWith('http') ? '_blank' : undefined}
              rel={study.liveLink.startsWith('http') ? 'noopener' : undefined}
              class="btn btn-primary cs-live"
            >
              Live Demo →
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Big hero image ── -->
  <section class="cs-hero-media-section">
    <div class="container">
      {study.hasMedia ? (
        <div class="frame cs-hero-media" data-reveal="clip">
          <Img src={`case-studies/${study.heroImage}`} alt={study.title} loading="eager" fetchpriority="high" />
        </div>
      ) : (
        <div class="placeholder-img cs-hero-media">Hero / Cover Image for {study.title}</div>
      )}
    </div>
  </section>

  {/* ════════ DESIGN case study body ════════ */}
  {!isArt && (
    <Fragment>
      <!-- ── Overview (full-black band for rhythm) ── -->
      <section class="cs-overview-section">
        <div class="container">
          <div class="cs-overview-grid">
            <p class="eyebrow cs-overview-label" data-reveal>Overview</p>
            <p class="cs-overview-text" data-reveal style="--i:1">{study.overview}</p>
          </div>
        </div>
      </section>

      <!-- ── Numbered content sections ── -->
      {study.sections.map((sec, i) => (
        <section class="cs-section">
          <div class="container">
            <header class="cs-section-head" data-reveal>
              <span class="cs-section-num">{num(i)}</span>
              <h2 class="cs-section-title">{sec.title}</h2>
            </header>

            <div class="cs-blocks">
              {sec.blocks.map((b, bi) => (
                <div class="cs-block" data-reveal style={`--i:${bi}`}>
                  <h3 class="cs-block-heading">{b.heading}</h3>
                  <p class="cs-block-text">{b.text}</p>
                </div>
              ))}
            </div>

            {study.hasMedia && study.images[i] && (
              <div class="frame cs-inline-img" data-reveal="clip">
                <Img src={`case-studies/${study.images[i]}`} alt={`${study.title} — ${sec.title}`} loading="lazy" />
              </div>
            )}
          </div>
        </section>
      ))}

      <!-- ── Video embed(s) (if present) — logic preserved ── -->
      {videos.length > 0 && (
        <section class="section cs-video-section">
          <div class="container">
            <p class="eyebrow cs-video-label" data-reveal>Watch</p>
            <div class={videos.length > 1 ? 'cs-video-grid' : ''}>
              {videos.map((vid, i) => (
                <div class="cs-video-wrapper" data-reveal style={`--i:${i % 2}`}>
                  <iframe
                    src={`https://www.youtube.com/embed/${vid}?rel=0&modestbranding=1&playsinline=1`}
                    title={`${study.title} video ${videos.length > 1 ? i + 1 : ''}`.trim()}
                    allow="encrypted-media; fullscreen; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </Fragment>
  )}

  {/* ════════ KAPA / ART body — gallery-forward, no client/award framing ════════ */}
  {isArt && (
    <Fragment>
      <!-- ── The Practice (full-black band) ── -->
      <section class="cs-overview-section">
        <div class="container">
          <div class="cs-overview-grid">
            <p class="eyebrow cs-overview-label" data-reveal>The Practice</p>
            <div class="kapa-practice" data-reveal style="--i:1">
              <p class="cs-overview-text">{study.overview}</p>
              {study.practice && <p class="kapa-practice-more">{study.practice}</p>}
            </div>
          </div>
        </div>
      </section>

      <!-- ── Materials & Process ── -->
      {study.process && study.process.length > 0 && (
        <section class="cs-section">
          <div class="container">
            <header class="cs-section-head" data-reveal>
              <span class="cs-section-num">01</span>
              <h2 class="cs-section-title">Materials &amp; Process</h2>
            </header>
            <div class="cs-blocks">
              {study.process.map((b, bi) => (
                <div class="cs-block" data-reveal style={`--i:${bi}`}>
                  <h3 class="cs-block-heading">{b.heading}</h3>
                  <p class="cs-block-text">{b.text}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- ── Meaning / Moʻolelo ── -->
      {study.meaning && (
        <section class="cs-section kapa-meaning">
          <div class="container">
            <header class="cs-section-head" data-reveal>
              <span class="cs-section-num">02</span>
              <h2 class="cs-section-title">Meaning · Moʻolelo</h2>
            </header>
            <p class="kapa-meaning-text" data-reveal>{study.meaning}</p>
          </div>
        </section>
      )}

      <!-- ── Gallery ── -->
      {study.gallery && study.gallery.length > 0 && (
        <section class="cs-section kapa-gallery-section">
          <div class="container">
            <header class="cs-section-head" data-reveal>
              <span class="cs-section-num">03</span>
              <h2 class="cs-section-title">The Piece</h2>
            </header>
            {study.hasMedia ? (
              <div class="kapa-gallery">
                {study.gallery.map((img, gi) => (
                  <div class="frame kapa-gallery-img" data-reveal="clip" style={`--i:${gi % 3}`}>
                    <Img src={`case-studies/${img}`} alt={`${study.title} — ${gi + 1}`} loading="lazy" />
                  </div>
                ))}
              </div>
            ) : (
              <div class="kapa-gallery">
                {study.gallery.map((img, gi) => (
                  <div class="placeholder-img kapa-gallery-img">Image — {img}</div>
                ))}
              </div>
            )}
          </div>
        </section>
      )}

      {/* ── Bilingual written component (ʻŌlelo Hawaiʻi ‖ English) ── */}
      {study.written && study.written.pairs && study.written.pairs.length > 0 && (
        <section class="cs-section kapa-written-section">
          <div class="container">
            <header class="cs-section-head" data-reveal>
              <span class="cs-section-num">04</span>
              <h2 class="cs-section-title">{study.written.label}</h2>
            </header>
            {study.written.intro && (
              <p class="kapa-written-intro" data-reveal>{study.written.intro}</p>
            )}
            <div class="kapa-written">
              <div class="kapa-written-head" data-reveal aria-hidden="true">
                <span class="kapa-written-lang">ʻŌlelo Hawaiʻi</span>
                <span class="kapa-written-lang">English</span>
              </div>
              {study.written.pairs.map((pair, pi) => (
                <div class="kapa-written-pair" data-reveal style={`--i:${pi % 2}`}>
                  <p class="kapa-written-haw" lang="haw">{pair.haw}</p>
                  <p class="kapa-written-eng" lang="en">{pair.eng}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </Fragment>
  )}

  <!-- ── Related Projects ── -->
  <section class="section related-section">
    <div class="container">
      <div class="related-head">
        <div>
          <p class="eyebrow" data-reveal>Other Projects</p>
          <h2 class="related-title" data-reveal="mask"><span>Other Case Studies</span></h2>
        </div>
        <a href="/case-studies" class="btn btn-outline related-all" data-reveal>All Projects →</a>
      </div>

      <div class="related-grid">
        {related.map((cs, i) => (
          <a href={`/case-studies/${cs.slug}`} class="case-card" data-reveal style={`--i:${i}`}>
            {cs.hasMedia ? (
              <div class="frame case-card-media" data-reveal="clip">
                <Img src={`case-studies/${cs.heroImage}`} alt={cs.title} loading="lazy" />
              </div>
            ) : (
              <div class="placeholder-img case-card-media">Related Project Thumbnail</div>
            )}
            <div class="case-card-body">
              <span class="eyebrow case-card-label">{cs.label || (cs.type === 'art' ? (cs.discipline || 'Art') : 'Case Study')}</span>
              <h3 class="case-card-title">{cs.title}</h3>
              <p class="case-card-desc">{cs.subtitle}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .cs-hero {
    padding: calc(var(--nav-height) + var(--space-lg)) 0 var(--space-md);
  }
  .cs-category { margin-bottom: var(--space-md); }

  .cs-title {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    line-height: 0.9;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    max-width: 18ch;
  }

  .cs-hero-meta {
    display: grid;
    grid-template-columns: 1fr minmax(0, 24rem);
    gap: var(--space-lg);
    align-items: end;
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .cs-subtitle {
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--color-ink);
    max-width: 36ch;
  }

  .cs-hero-aside { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }

  .cs-award {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ── Hero image ── */
  .cs-hero-media-section { padding-bottom: var(--space-lg); }
  .cs-hero-media {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .cs-hero-media img { width: 100%; height: 100%; object-fit: cover; }

  /* ── Overview (full-black band) ── */
  .cs-overview-section {
    background: #0a0a0a;
    color: #fff;
    padding: var(--space-xl) 0;
  }
  .cs-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 12rem) 1fr;
    gap: var(--space-lg);
    align-items: start;
  }
  .cs-overview-label { color: rgba(255, 255, 255, 0.65); }
  .cs-overview-text {
    font-size: var(--fs-xl);
    line-height: 1.4;
    color: #fff;
    max-width: 30ch;
  }

  /* ── Sections ── */
  .cs-section { padding: var(--space-xl) 0; border-bottom: 1px solid var(--color-border); }

  .cs-section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .cs-section-num {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .cs-section-title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 0.94;
    color: var(--color-ink);
  }

  .cs-blocks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg) var(--space-lg);
  }
  .cs-block-heading {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }
  .cs-block-heading::before {
    content: '';
    display: inline-block;
    width: 0.5rem; height: 0.5rem;
    background: var(--color-accent);
    border-radius: 50%;
    margin-right: 0.55em;
    vertical-align: 0.18em;
  }
  .cs-block-text {
    font-size: var(--fs-base);
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 56ch;
  }

  /* ── Inline section images ── */
  .cs-inline-img {
    margin-top: var(--space-lg);
    width: 100%;
  }
  /* :global + higher specificity so it overrides the global `.frame img` cover rule
     for <Img>-rendered images (inline images show full, not cropped). */
  .cs-inline-img :global(img) { width: 100%; height: auto; object-fit: contain; display: block; }

  /* ── Video ── */
  .cs-video-label { margin-bottom: var(--space-md); }
  .cs-video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }
  .cs-video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    background: var(--color-surface);
  }
  .cs-video-wrapper iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: none;
  }

  /* ── Kapa: The Practice ── */
  .kapa-practice { display: flex; flex-direction: column; gap: var(--space-md); }
  .kapa-practice-more {
    font-size: var(--fs-base);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.72);
    max-width: 52ch;
  }

  /* ── Kapa: Meaning / Moʻolelo ── */
  .kapa-meaning-text {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: 1.3;
    color: var(--color-ink);
    max-width: 30ch;
  }

  /* ── Kapa: gallery ── */
  .kapa-gallery {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-md);
  }
  /* default: 2-up rows for any images beyond the first three */
  .kapa-gallery-img { width: 100%; grid-column: span 3; aspect-ratio: 4 / 5; }
  /* first three pieces sit together in one row of 3 */
  .kapa-gallery-img:nth-child(-n+3) { grid-column: span 2; aspect-ratio: 4 / 3; }
  .kapa-gallery-img img { width: 100%; height: 100%; object-fit: cover; }
  .kapa-gallery-img.placeholder-img {
    display: flex; align-items: center; justify-content: center;
    text-align: center; padding: var(--space-md);
  }
  @media (max-width: 700px) {
    .kapa-gallery { grid-template-columns: 1fr; }
    .kapa-gallery-img,
    .kapa-gallery-img:nth-child(-n+3) { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
  }

  /* ── Kapa: bilingual written component ── */
  .kapa-written-intro {
    font-size: var(--fs-base);
    line-height: 1.8;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-lg);
  }
  .kapa-written { display: flex; flex-direction: column; gap: var(--space-lg); }
  .kapa-written-head,
  .kapa-written-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  .kapa-written-head { margin-bottom: calc(-1 * var(--space-md)); }
  .kapa-written-lang {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .kapa-written-lang::before {
    content: '';
    width: 0.5rem; height: 0.5rem;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .kapa-written-haw,
  .kapa-written-eng {
    margin: 0;
    font-size: var(--fs-base);
    line-height: 1.85;
  }
  /* ʻŌlelo Hawaiʻi is the primary voice */
  .kapa-written-haw {
    color: var(--color-ink);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-accent);
  }
  .kapa-written-eng { color: var(--color-text-muted); }
  @media (max-width: 760px) {
    .kapa-written-head { display: none; }
    .kapa-written-pair { grid-template-columns: 1fr; gap: var(--space-sm); }
  }

  /* ── Related ── */
  .related-section { border-top: 1px solid var(--color-border); }
  .related-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .related-title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 0.94;
    color: var(--color-ink);
    margin-top: var(--space-sm);
  }
  .related-all { flex-shrink: 0; }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .case-card { display: flex; flex-direction: column; color: inherit; text-decoration: none; }
  .case-card-media {
    aspect-ratio: 4 / 3;
    width: 100%;
    margin-bottom: var(--space-sm);
  }
  .case-card-media img { width: 100%; height: 100%; object-fit: cover; }
  .case-card-body { display: flex; flex-direction: column; }
  .case-card-label { margin-bottom: var(--space-xs); }
  .case-card-title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    line-height: 1;
    color: var(--color-ink);
    margin-bottom: var(--space-2xs);
    transition: color var(--transition);
  }
  .case-card:hover .case-card-title { color: var(--color-text-muted); }
  .case-card-desc {
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .cs-hero-meta { grid-template-columns: 1fr; gap: var(--space-md); }
    .cs-overview-grid { grid-template-columns: 1fr; gap: var(--space-md); }
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .cs-blocks { grid-template-columns: 1fr; gap: var(--space-md); }
    .cs-video-grid { grid-template-columns: 1fr; }
    .cs-section-head { flex-direction: column; gap: var(--space-xs); }
  }
  @media (max-width: 600px) {
    .related-grid { grid-template-columns: 1fr; }
    .related-head { flex-direction: column; align-items: flex-start; }
  }
</style>
