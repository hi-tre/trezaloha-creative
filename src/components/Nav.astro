---
// Nav.astro, editorial minimal navbar (white base, black ink, gold hover)
const navLinks = [
  { label: 'About',    href: '/about' },
  { label: 'Projects', href: '/case-studies' },
  { label: 'Services', href: '/services' },
  { label: 'Field Notes', href: '/field-notes' },
];
const currentPath = Astro.url.pathname;
const isActive = (href) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="nav" id="main-nav">
  <div class="nav-inner">
    <!-- Left cluster: logo + primary links -->
    <div class="nav-left">
      <a href="/" class="nav-logo" aria-label="Trezaloha Creative, Home">
        <img src="/images/trezaloha-wordmark.png" alt="Trezaloha Creative" class="nav-logo-img" />
      </a>
      <nav class="nav-group" aria-label="Main navigation">
        <a href="/about" class={`nav-link ${isActive('/about') ? 'active' : ''}`}>About</a>
        <a href="/case-studies" class={`nav-link ${isActive('/case-studies') ? 'active' : ''}`}>Projects</a>
        <a href="/services" class={`nav-link ${isActive('/services') ? 'active' : ''}`}>Services</a>
      </nav>
    </div>

    <!-- Right cluster -->
    <nav class="nav-group nav-right" aria-label="Secondary navigation">
      <a href="/field-notes" class={`nav-link ${isActive('/field-notes') ? 'active' : ''}`}>Field Notes</a>
      <a href="/contact-us" class={`nav-link ${isActive('/contact-us') ? 'active' : ''}`}>Contact</a>
    </nav>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>

  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    {navLinks.map(link => (
      <a href={link.href} class="nav-mobile-link">{link.label}</a>
    ))}
    <a href="/contact-us" class="nav-mobile-link">Contact</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: var(--nav-height);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), background var(--transition);
  }
  .nav.scrolled {
    background: rgba(255, 255, 255, 0.92);
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    height: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .nav-left { display: flex; align-items: center; gap: clamp(1.5rem, 4vw, 4rem); }
  .nav-logo { display: flex; align-items: center; flex-shrink: 0; }
  /* white wordmark art → forced black for the light theme */
  .nav-logo-img { height: 30px; width: auto; display: block; filter: brightness(0); }

  .nav-group { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2.5rem); }

  .nav-link {
    position: relative;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding: 0.25rem 0;
  }
  .nav-link::after {
    content: '';
    position: absolute; left: 0; bottom: -3px;
    width: 100%; height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }

  .nav-link--cta::after { transform-origin: left; }

  /* Hamburger */
  .nav-toggle { display: none; flex-direction: column; gap: 6px; background: none; border: none; cursor: pointer; padding: 6px; }
  .nav-toggle span { display: block; width: 26px; height: 2px; background: var(--color-ink); transition: var(--transition); }
  .nav-toggle.open span:nth-child(1) { transform: translateY(4px) rotate(45deg); }
  .nav-toggle.open span:nth-child(2) { transform: translateY(-4px) rotate(-45deg); }

  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: var(--space-sm) var(--gutter) var(--space-md);
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }
  .nav-mobile-link {
    font-family: var(--font-display);
    font-size: 2rem;
    text-transform: uppercase;
    color: var(--color-ink);
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .nav-mobile-link:hover { color: var(--color-text-muted); }

  @media (max-width: 760px) {
    .nav-group { display: none; }
    .nav-toggle { display: flex; }
    .nav-mobile.open { display: flex; }
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.classList.toggle('open');
    mobile?.classList.toggle('open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    mobile?.setAttribute('aria-hidden', String(!isOpen));
  });
</script>
